    {
      "name": "02 Books",
      "item": [
        {
          "name": "1. List Books Paginated (GET /api/books)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.items && jsonData.data.items.length > 0) {",
                  "  pm.environment.set('bookId', jsonData.data.items[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/books?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "2. Get Single Book Details (GET /api/books/:id)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["api", "books", "{{bookId}}"] }
          }
        },
        {
          "name": "3. Create Book as Librarian (POST /api/books)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{librarianToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Architecture and Microservices\",\n  \"author\": \"Martin Fowler\",\n  \"isbn\": \"9780134494166\",\n  \"category\": \"Software Engineering\",\n  \"publisher\": \"Addison-Wesley\",\n  \"publicationYear\": 2023,\n  \"totalCopies\": 4,\n  \"availableCopies\": 4,\n  \"description\": \"Comprehensive guide on domain-driven design, event sourcing, and container orchestration.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "4. Member Create Book Forbidden (403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Creation\",\n  \"author\": \"Student\",\n  \"isbn\": \"9780000000999\",\n  \"category\": \"General\",\n  \"totalCopies\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "5. Duplicate ISBN Error (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{librarianToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Duplicate Book\",\n  \"author\": \"Silberschatz\",\n  \"isbn\": \"9780078022159\",\n  \"category\": \"Computer Science\",\n  \"totalCopies\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/books", "host": ["{{baseUrl}}"], "path": ["api", "books"] }
          }
        },
        {
          "name": "6. Update Book by Librarian (PUT /api/books/:id)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{librarianToken}}" },
