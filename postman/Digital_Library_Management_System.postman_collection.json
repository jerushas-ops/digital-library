{
  "info": {
    "_postman_id": "d05-digital-library-api-collection",
    "name": "Digital Library Management System (P05) REST API",
    "description": "Comprehensive Postman Test Collection for the University Digital Library Management System covering all 13 modules, RBAC roles, workflows, validation errors, and business conflicts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "1. Member Signup (POST /api/auth/register)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Student\",\n  \"email\": \"postman.student@library.edu\",\n  \"password\": \"Password123!\",\n  \"memberType\": \"STUDENT\",\n  \"phone\": \"+1 (555) 019-8822\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "2. Duplicate Registration Rejection (409 Conflict)",
          "request": {
            "method": "POST",
