        {
          "name": "1. Issue Book to Member (POST /api/transactions/issue)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.data && jsonData.data.transaction) {",
                  "  pm.environment.set('transactionId', jsonData.data.transaction._id);",
                  "}"
