          "name": "3. Create Librarian Account (POST /api/admin/librarians)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Assistant Librarian\",\n  \"email\": \"assistant.lib@library.edu\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+1 (555) 012-3344\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/librarians", "host": ["{{baseUrl}}"], "path": ["api", "admin", "librarians"] }
          }
        },
        {
          "name": "4. Get System Audit Logs (GET /api/admin/audit-logs)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/audit-logs", "host": ["{{baseUrl}}"], "path": ["api", "admin", "audit-logs"] }
          }
        }
      ]
    }
  ]
}
