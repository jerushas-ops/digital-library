            "body": {
              "mode": "raw",
              "raw": "{\n  \"condition\": \"GOOD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/transactions/{{transactionId}}/return", "host": ["{{baseUrl}}"], "path": ["api", "transactions", "{{transactionId}}", "return"] }
          }
